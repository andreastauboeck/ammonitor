# ENVIRONMENT and VERSION are read from the VERSION file / docker-compose overrides.
# Add other env vars (e.g. SENTRY_DSN) here as needed.

# Optional: Open-Meteo commercial API key.
# When set, used as a fallback if the free api.open-meteo.com endpoint fails.
# Obtain from https://open-meteo.com/en/pricing
#
# Local dev: add the real value to your .env file (gitignored, never commit it).
# Fly.io:    set once via the CLI — never put the key in fly.toml or source code:
#              fly secrets set OPEN_METEO_API_KEY=<your-key>
OPEN_METEO_API_KEY=
